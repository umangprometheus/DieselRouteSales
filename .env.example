# MSP Diesel Field Sales Route App - Environment Variables
# Copy this file to .env for local development or VM deployment
# DO NOT commit .env to version control

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# For Replit (automatically provided by Neon integration):
# DATABASE_URL is automatically set by Replit's PostgreSQL integration
# Format: postgres://username:password@hostname/database?sslmode=require

# For VM/Self-hosted deployment with standard PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/msp_diesel_routes
# Example with local PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/msp_diesel_routes

DATABASE_URL=your_neon_or_postgres_connection_string_here

# PostgreSQL connection details (provided automatically by Replit)
PGHOST=your_postgres_host
PGPORT=5432
PGUSER=your_postgres_user
PGPASSWORD=your_postgres_password
PGDATABASE=msp_diesel_routes

# ============================================================================
# HUBSPOT CRM INTEGRATION
# ============================================================================

# HubSpot Private App API Key
# Get this from: HubSpot Account > Settings > Integrations > Private Apps
# Required scopes: crm.objects.companies.read, crm.objects.contacts.read
# Optional: crm.schemas.custom.read (for custom field visits object)
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: HubSpot Field Visit Association Type ID
# Only needed if you created a custom "field_visits" object
# Leave blank to fall back to creating HubSpot Notes instead
HUBSPOT_FIELD_VISIT_ASSOCIATION_TYPE_ID=

# ============================================================================
# MAPBOX INTEGRATION
# ============================================================================

# Mapbox API Access Token
# Get this from: https://account.mapbox.com/access-tokens/
# Required scopes: styles:read, geocoding, directions
MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjbHh4eHh4eHh4eHh4eHh4eHh4In0.xxxxxxxxxxxxxxxxxxxxxxxxxxx

# IMPORTANT: Must duplicate MAPBOX_TOKEN as VITE_MAPBOX_TOKEN for client-side use
# Vite only exposes env vars prefixed with VITE_ to the frontend
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjbHh4eHh4eHh4eHh4eHh4eHh4In0.xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# SESSION SECURITY
# ============================================================================

# Session Secret Key (for cookie encryption)
# Generate a strong random string (32+ characters)
# Use: openssl rand -base64 32
SESSION_SECRET=your_random_32_character_or_longer_secret_key_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Node Environment
# Options: development, production
NODE_ENV=development

# Server Port (default: 5000)
# Note: Replit automatically sets PORT, this is for VM deployment
PORT=5000

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================

# Replit Deployment:
# - All secrets are managed through Replit's Secrets panel
# - No .env file needed - use the Secrets UI
# - DATABASE_URL is automatically provided by PostgreSQL integration

# VM Deployment:
# 1. Create .env file with these variables
# 2. Ensure PostgreSQL is installed and running
# 3. Create database: createdb msp_diesel_routes
# 4. Run migrations: npm run db:push
# 5. Start with PM2: pm2 start ecosystem.config.js

# Security Best Practices:
# - Never commit .env to git
# - Use strong random values for SESSION_SECRET
# - Rotate API keys periodically
# - Use read-only database credentials when possible
# - Enable SSL for PostgreSQL connections in production
